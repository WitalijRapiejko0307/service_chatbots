# Local Docker development — copy to frontend/.env.local (gitignored)
# Run: ./scripts/dev-setup.sh   or   cp frontend/.env.local.example frontend/.env.local
#
# URLs point to localhost because the browser runs on the host, not inside Docker.
# On Railway (two public domains) these are baked at image build time.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
