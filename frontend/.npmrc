# Enforce the "engines" field in package.json so a mismatched local Node/npm
# (e.g. Node 24 / npm 12 on a developer host) fails loudly instead of silently
# regenerating package-lock.json in a way that's incompatible with the npm
# version used by docker/Dockerfile.frontend (node:20-alpine, npm 10.x) and by
# Railway's build. See docs/fix/frontend-lockfile-docker-sync.md for the
# incident this prevents.
engine-strict=true
