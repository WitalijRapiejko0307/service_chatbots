# ============================================================
# Service ChatBot — Environment Variables Reference
# ============================================================
# Copy this file to .env (compose Postgres) and/or use
# backend/.env.example → backend/.env for the API.
# Never commit real tokens. All secrets belong in gitignored env files.
# ============================================================

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=Service ChatBot API
APP_VERSION=0.1.0
APP_URL=http://localhost:8000
FRONTEND_URL=

# Production: ENVIRONMENT=production requires a valid SECRET_ENCRYPTION_KEY (Fernet).
# Messenger webhook paths are not IP-rate-limited (shared platform IPs).

CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=service_chatbot
COMPOSE_PROJECT_NAME=service-chatbot-dev

# Docker Compose service hostname is "postgres".
DATABASE_URL=postgresql://agent:agent@postgres:5432/service_chatbot?sslmode=disable

# Fernet key for encrypting channel tokens. Required when ENVIRONMENT=production.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────
# Auth (placeholders — used in Block B)
# ─────────────────────────────────────────────
JWT_SECRET_KEY=local-dev-jwt-secret-min-32-chars
JWT_EXPIRES_HOURS=8

# ─────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Channels — placeholders only. Put real values in backend/.env
# (see docs/partner-accounts.md). Do not commit tokens.
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

VIBER_AUTH_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_MESSAGING_ENABLED=false
