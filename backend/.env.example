# Local Docker development — copy to backend/.env (gitignored)
# Run: ./scripts/dev-setup.sh   or   cp backend/.env.example backend/.env

APP_NAME=Service ChatBot API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
APP_URL=http://localhost:8000

# Production: ENVIRONMENT=production requires a valid SECRET_ENCRYPTION_KEY (Fernet).
# Messenger webhook paths (/api/v1/{telegram,viber,instagram,tiktok}/webhook) are not IP-rate-limited.

DATABASE_URL=postgresql://agent:agent@postgres:5432/service_chatbot?sslmode=disable
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000

# Optional — required for live LLM/RAG replies in web chat
OPENAI_API_KEY=

# Required when ENVIRONMENT=production (valid Fernet key). Optional in development until secrets are written.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

JWT_SECRET_KEY=local-dev-jwt-secret-min-32-chars
JWT_EXPIRES_HOURS=8

# Bootstrap admin (created by migrate if missing)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme123

# Dev fallback only — prefer POST /api/v1/admin/auth/login-password
ADMIN_TOKEN=

# Local file storage for RAG uploads (served at /storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/storage

# Channel placeholders — Block D (messengers)
TELEGRAM_BOT_TOKEN=
VIBER_AUTH_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_MESSAGING_ENABLED=false
