# Local Docker development — copy to backend/.env (gitignored)
# Run: ./scripts/dev-setup.sh   or   cp backend/.env.example backend/.env

APP_NAME=Service ChatBot API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=

# Production: ENVIRONMENT=production requires a valid SECRET_ENCRYPTION_KEY (Fernet).
# Messenger webhook paths (/api/v1/{telegram,viber,instagram,tiktok}/webhook) are not IP-rate-limited.

DATABASE_URL=postgresql://agent:agent@postgres:5432/service_chatbot?sslmode=disable
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000

# Optional — required for live LLM/RAG replies in web chat
OPENAI_API_KEY=

# Required when ENVIRONMENT=production (valid Fernet key). Optional in development until secrets are written.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

JWT_SECRET_KEY=local-dev-jwt-secret-min-32-chars
JWT_EXPIRES_HOURS=8

# Comma-separated super-admin emails (OTP login). If empty/unset, super-admin features are
# unavailable to everyone. Required in production — set at least one trusted email.
ALLOWED_ADMIN_EMAILS=admin@example.com

# Bootstrap admin (created by migrate if missing)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme123

# Dev fallback only — prefer POST /api/v1/admin/auth/login-password
ADMIN_TOKEN=

# Local file storage for RAG uploads (served at /storage) — NOT persistent on Railway (ephemeral disk).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/storage

# Production on Railway: use an S3-compatible Railway Bucket instead (persists across deploys).
# Get credentials via `railway bucket credentials --bucket <name> --json`, then set:
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
# S3_PUBLIC_URL_PREFIX=
# NOTE: bucket must allow public GetObject (no ListBucket) for RAG/vision/Telegram to fetch files.

# Channel placeholders — Block D (messengers)
TELEGRAM_BOT_TOKEN=
VIBER_AUTH_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
# Page tokens from Graph API Explorer expire (~60 days) unless you use a System User token.
# Instagram Login (OAuth) long-lived tokens are refreshed on verify and on a background loop.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_MESSAGING_ENABLED=false
